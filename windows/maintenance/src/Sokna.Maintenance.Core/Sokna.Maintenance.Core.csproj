  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ProductionLocalSlotMigration.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="RoutineLocalDatabase.php" LogicalName="Sokna.Maintenance.Core.RoutineLocalDatabase.php" />
    <EmbeddedResource Include="StableLocalRecovery.php"
                      LogicalName="Sokna.Maintenance.Core.StableLocalRecoveryPhp" />
  </ItemGroup>
