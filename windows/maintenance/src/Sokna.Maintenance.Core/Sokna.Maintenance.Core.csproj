<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>SoknaMaintenanceCore</AssemblyName>
    <Version>0.2.5</Version>
    <AssemblyVersion>0.2.5.0</AssemblyVersion>
    <FileVersion>0.2.5.0</FileVersion>
    <InformationalVersion>0.2.5</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ProductionLocalSlotMigration.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <!-- Publisher PUBLIC SPKI is embedded into the installed binary during
       authenticated Windows Services packaging. No key material is read from
       the selected Local ZIP. No private key is ever placed here. -->
  <Target Name="ValidateSoknaPublisherPublicKey" BeforeTargets="CoreCompile"
          Condition="'$(SoknaPublisherSpkiPem)' != ''">
    <Error Condition="!Exists('$(SoknaPublisherSpkiPem)')"
           Text="PROTECTED_PUBLISHER_PUBLIC_KEY_RESOURCE_MISSING" />
  </Target>
  <ItemGroup Condition="'$(SoknaPublisherSpkiPem)' != ''">
    <EmbeddedResource Include="$(SoknaPublisherSpkiPem)"
                      LogicalName="Sokna.Maintenance.Core.publisher.spki.pem" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../../apps/local-web/public/local-recovery.php"
                      LogicalName="Sokna.Maintenance.Core.StableLocalRecoveryPhp" />
  </ItemGroup>
</Project>
