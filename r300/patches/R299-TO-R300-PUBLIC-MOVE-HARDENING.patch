+<?php
+declare(strict_types=1);
+
+namespace Sokna\Local\Domain\PublicEdge;
+
+use Throwable;
+
+/**
+ * R300: non-sensitive, deterministic error taxonomy for the existing Public move.
+ * The raw exception (SQL, URL, token, filesystem) is NEVER sent to the browser.
+ * This class performs no writes and does not authorize any cutover.
+ */
+final class PublicMoveFailureDiagnostic
+{
+    private const EXPIRED = [
+        'move_challenge_not_active','challenge_not_current','approval_expired',
+        'owner_receipt_expired','expired_or_invalid_challenge','invalid_or_expired_challenge',
+    ];
+    private const OWNER_PROOF = [
+        'signed_owner_receipt_required','owner_receipt_envelope_invalid',
+        'owner_receipt_shape_invalid','owner_receipt_fields_invalid','owner_receipt_challenge_mismatch',
+        'owner_receipt_challenge_hash_invalid','owner_receipt_attestation_mismatch',
+        'owner_receipt_signature_invalid','owner_attestation_signature_invalid',
+        'attestation_payload_missing','attestation_binding_mismatch','signature_not_verified',
+        'wrong_challenge_contract','trusted_owner_approval_required','conflicting_approval_receipt',
+        'invalid_attestation_envelope','invalid_wire_shape','invalid_preflight_proof',
+    ];
+    private const LOCAL_ADMIN = [
+        'local_session_unavailable','operator_not_authenticated','local_authenticated_operator_required',
+        'local_admin_for_installation_required','local_operator_csrf_invalid',
+        'owner_offer_session_not_active','move_session_not_active',
+    ];
+    private const TARGET_ID = [
+        'existing_destination_identity_or_pairing_mismatch','existing_destination_authority_response_invalid',
+        'existing_destination_epoch_not_ahead','source_public_binding_changed',
+        'local_public_settings_changed_during_replacement','invalid_owner_issued_pairing_code',
+        'invalid_public_move_kind','move_target_url_invalid','existing_move_operation_changed',
+    ];
+    private const RESUME = [
+        'another_migration_already_active','another_replacement_in_progress',
+        'replacement_already_in_progress','replacement_pairing_uncertain_needs_review',
+        'replacement_not_ready_for_sync','claimed_operation_requires_recovery',
+        'paired_replacement_must_finish_before_cancel','operation_not_current_for_installation',
+        'replacement_state_missing','replacement_state_invalid',
+    ];
+
+    public static function classify(Throwable $error, string $action, array $pending, string $bindingState): array
+    {
+        $raw = $error->getMessage();
+        // Exception messages are used ONLY as exact, predefined codes. They are
+        // never returned or persisted as arbitrary strings.
+        $pendingState = (string)($pending['status'] ?? 'unknown');
+        $hasJournal = ($pending['active'] ?? false) === true;
+        $bindingChanged = $bindingState === 'target';
+        if (in_array($raw, self::EXPIRED, true)) {
+            $code = 'public_move_challenge_expired';
+            $instruction = 'اعتبار تأیید مالک تمام شده است؛ ابتدا وضعیت عملیات را بررسی کنید و اگر انتقال شروع نشده، درخواست تازه بسازید.';
+            $policy = $hasJournal ? 'resume_existing_operation' : 'restart_owner_challenge';
+        } elseif (in_array($raw, self::OWNER_PROOF, true)) {
+            $code = 'public_move_owner_proof_invalid';
+            $instruction = 'رسید امضاشدهٔ مالک برای همین درخواست پذیرفته نشد؛ اتصال جدید تأیید نشده است.';
+            $policy = 'review_owner_receipt';
+        } elseif (in_array($raw, self::LOCAL_ADMIN, true)) {
+            $code = 'public_move_local_admin_session_required';
+            $instruction = 'نشست مدیر Local یا درخواست فعال معتبر نیست؛ بدون شروع عملیات جدید وضعیت فعلی را بررسی کنید.';
+            $policy = 'review_local_admin_session';
+        } elseif (in_array($raw, self::TARGET_ID, true)) {
+            $code = 'public_move_destination_identity_mismatch';
+            $instruction = 'هویت، نسل اتصال یا تنظیمات مقصد با عملیات تأییدشده منطبق نیست؛ انتقال متوقف شد.';
+            $policy = 'review_destination_identity';
+        } elseif (in_array($raw, self::RESUME, true) || $bindingChanged || $hasJournal) {
+            $code = 'public_move_recovery_required';
+            $instruction = 'عملیات انتقال قبلاً شروع شده یا نتیجه آن نامطمئن است؛ وضعیت همان عملیات را بازیابی کنید و کد جدید نسازید.';
+            $policy = 'resume_existing_operation';
+        } elseif ($error instanceof PublicEdgeSyncException) {
+            $code = $error->httpStatus === 404 ? 'public_move_destination_http_404' : 'public_move_destination_unreachable';
+            $instruction = $error->httpStatus === 404
+                ? 'مسیر API مقصد پیدا نشد؛ آدرس و نسخهٔ Public بررسی شود، بدون هیچ تغییر در اتصال.'
+                : 'ارتباط امن با مقصد کامل نشد؛ وضعیت مقصد باید پیش از ادامه بررسی شود.';
+            $policy = 'check_destination_health';
+        } elseif ($raw === 'active_public_connection_required') {
+            $code = 'public_move_local_authority_not_ready';
+            $instruction = 'مرجع ارتباط Local برای شروع عملیات مجاز نیست؛ وضعیت اتصال ابتدا بررسی شود.';
+            $policy = 'review_local_authority';
+        } else {
+            $code = 'public_move_unclassified_failure';
+            $instruction = 'علت انتقال مشخص نشد. با کد پیگیری، مرحله شکست را در گزارش پشتیبانی بررسی کنید.';
+            $policy = 'support_required';
+        }
+        // After a durable journal or config commit, claiming the Local was
+        // unchanged is unsafe. The response is a snapshot, not a rollback proof.
+        return [
+            'success' => false,
+            'code' => $code,
+            'message' => $instruction,
+            'move_step' => self::step($action),
+            'recovery_policy' => $policy,
+            'move_status' => in_array($pendingState,['none','sync_pending','support_required'],true)
+                ? $pendingState : 'unknown',
+            'binding_state' => $bindingState,
+            'local_connection_preserved' => $bindingChanged ? false :
+                (!$hasJournal && $bindingState==='not_target' ? true : null),
+            'safe_to_cutover' => false,
+            'restart_without_status_check_allowed' => false,
+        ];
+    }
+
+    public static function safeReason(Throwable $error): string
+    {
+        $raw = $error->getMessage();
+        foreach([self::EXPIRED,self::OWNER_PROOF,self::LOCAL_ADMIN,self::TARGET_ID,self::RESUME] as $set) {
+            if (in_array($raw,$set,true)) return $raw;
+        }
+        if ($error instanceof PublicEdgeSyncException) {
+            return preg_match('/^[a-z0-9_]{3,64}$/D',$error->errorCode) === 1
+                ? $error->errorCode : 'public_sync_exception';
+        }
+        return 'unclassified';
+    }
+
+    private static function step(string $action): string
+    {
+        return match($action) {
+            'public_move_begin' => 'create_challenge',
+            'public_move_confirm' => 'verify_owner_and_local_admin',
+            'public_move_existing_owner_offer_execute' => 'exchange_owner_authority_offer',
+            'public_move_finish' => 'sync_commit_activate',
+            'public_move_cancel' => 'cancel_before_commit',
+            'public_move_status' => 'readback',
+            default => 'unknown',
+        };
+    }
+}