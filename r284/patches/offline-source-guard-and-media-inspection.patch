     private const MAX_TOTAL_BYTES=32212254720;
     private const MAX_FILES=50000;
 
+    /**
+     * Authenticate the exact media archive against source Local and business
+     * snapshot BEFORE issuing the old-machine handoff. No private files are
+     * written under a target or active vault by this read-only verification.
+     */
+    public function inspect(
+        string $archive,string $passphrase,string $sourceInstallationId,string $businessBackupSha
+    ):array {
+        self::requireCrypto($passphrase);
+        self::validateSha($businessBackupSha);
+        $sourceInstallationId=self::validateInstallationId($sourceInstallationId);
+        if(!is_file($archive)||is_link($archive))
+            throw new RecoveryException('media_archive_missing','فایل رسانه‌ای وجود ندارد.',404);
+        $zip=self::temporary('sokna-media-inspect','.zip');
+        try{
+            $this->decrypt($archive,$zip,$passphrase);
+            $m=$this->verifyPlainZip($zip,$sourceInstallationId,$businessBackupSha);
+            return ['media_files'=>count($m['files']),'total_bytes'=>(int)$m['total_bytes'],
+                'source_installation_id'=>$sourceInstallationId,
+                'business_backup_sha256'=>$businessBackupSha,
+                'media_archive_sha256'=>hash_file('sha256',$archive)];
+        }finally{@unlink($zip);}
+    }
+
     /** Creates a separate encrypted archive. Does not change any source file. */
