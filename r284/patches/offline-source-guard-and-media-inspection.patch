@@ -21,6 +21,15 @@
 $dataDir=rtrim(trim((string)($config['app']['data_dir']??'')),"\\/");
+$offlineMarker=$dataDir!==''?$dataDir.DIRECTORY_SEPARATOR.'lifecycle'.DIRECTORY_SEPARATOR.'local'.DIRECTORY_SEPARATOR.'offline-machine-fenced.json':'';
+// An offline source machine is retired permanently from business traffic:
+// block browser, Runtime, PrintAgent, LAN staff and all regular API requests
+// BEFORE bootstrap or session. Never trust a browser-supplied override.
+if($offlineMarker!==''&&(file_exists($offlineMarker)||is_link($offlineMarker))){
+    http_response_code(503);header('Content-Type: application/json; charset=utf-8');
+    header('Cache-Control: no-store');header('Retry-After: 86400');
+    echo json_encode(['success'=>false,'code'=>'LOCAL_MACHINE_TRANSFER_FENCED',
+        'message'=>'این رایانه برای انتقال به دستگاه جدید غیرفعال شده است.'],JSON_UNESCAPED_UNICODE);exit;
+}
 $recoveryMarker=$dataDir!==''?$dataDir.DIRECTORY_SEPARATOR.'lifecycle'.DIRECTORY_SEPARATOR.'local'.DIRECTORY_SEPARATOR.'recovery-required.json':'';
