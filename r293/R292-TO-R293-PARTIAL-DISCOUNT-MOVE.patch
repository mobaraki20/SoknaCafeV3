+-- R293: an immutable, single remaining-balance discount after the first itemized payment.
+-- Existing settlement receipts and the original invoice-wide discount stay unchanged.
+CREATE TABLE IF NOT EXISTS remaining_account_discount_grants (
+    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+    session_id BIGINT UNSIGNED NOT NULL,
+    discount_type VARCHAR(10) NOT NULL,
+    discount_value BIGINT UNSIGNED NOT NULL,
+    base_unpaid_subtotal BIGINT UNSIGNED NOT NULL,
+    discount_amount BIGINT UNSIGNED NOT NULL,
+    actor_user_id INT UNSIGNED NULL,
+    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    UNIQUE KEY uq_remaining_discount_session (session_id),
+    CONSTRAINT fk_remaining_grant_session FOREIGN KEY (session_id) REFERENCES table_sessions(id) ON UPDATE CASCADE ON DELETE RESTRICT,
+    CONSTRAINT fk_remaining_grant_actor FOREIGN KEY (actor_user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE SET NULL,
+    CONSTRAINT ck_remaining_grant_type CHECK (discount_type IN ('percent','fixed'))
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+
+CREATE TABLE IF NOT EXISTS remaining_account_discount_lines (
+    grant_id BIGINT UNSIGNED NOT NULL,
+    order_item_id BIGINT UNSIGNED NOT NULL,
+    quantity_snapshot INT UNSIGNED NOT NULL,
+    paid_quantity_at_grant INT UNSIGNED NOT NULL,
+    original_discount_snapshot BIGINT UNSIGNED NOT NULL,
+    discount_amount BIGINT UNSIGNED NOT NULL,
+    invoice_tax_after_grant BIGINT UNSIGNED NOT NULL,
+    invoice_taxable_after_grant BIGINT UNSIGNED NOT NULL,
+    PRIMARY KEY(grant_id, order_item_id),
+    CONSTRAINT fk_remaining_line_grant FOREIGN KEY (grant_id) REFERENCES remaining_account_discount_grants(id) ON UPDATE CASCADE ON DELETE RESTRICT,
+    CONSTRAINT fk_remaining_line_item FOREIGN KEY (order_item_id) REFERENCES order_items(id) ON UPDATE CASCADE ON DELETE RESTRICT
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
