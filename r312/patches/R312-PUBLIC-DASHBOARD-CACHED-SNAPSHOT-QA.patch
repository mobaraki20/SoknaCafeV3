+.sc-dashboard-snapshot__stats>div{display:grid;gap:6px;background:var(--sc-surface-subtle);border:1px solid var(--sc-border);border-radius:var(--sc-radius-md);padding:12px}
+.sc-dashboard-snapshot__stats small{font-size:.75rem;color:var(--sc-muted)}
+.sc-dashboard-snapshot__stats strong{font-size:1.1rem;color:var(--sc-text);overflow-wrap:anywhere}
+.sc-dashboard-snapshot__foot{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;font-size:.77rem;color:var(--sc-muted)}
+.sc-dashboard-snapshot__foot a{color:var(--sc-accent);font-weight:750}
+@media(max-width:480px){.sc-dashboard-snapshot .sc-card__body{gap:8px;padding:14px}.sc-dashboard-snapshot__head h2{font-size:1.07rem}.sc-dashboard-snapshot__stats>div{padding:9px}.sc-dashboard-snapshot__stats strong{font-size:.93rem}.sc-dashboard-snapshot__stats small{font-size:.68rem}.sc-dashboard-snapshot__foot{font-size:.7rem}}
