+        $snapshotDay=(string)($dashboard['range']['to']??'');
+        if(preg_match('/^(\d{4})-(\d{2})-(\d{2})$/D',$snapshotDay,$m)!==1
+            ||!checkdate((int)$m[2],(int)$m[3],(int)$m[1])
