{
  "format": "sokna-windows-services-compatibility-v1",
  "schema_version": 1,
  "package_component": "windows-services-packaging",
  "package_version_source": "packaging/windows/WINDOWS_SERVICES_VERSION.txt",
  "components": {
    "runtime": {
      "version": "1.0.1",
      "runtime_contract": "1.0.0",
      "service_name": "SoknaRuntime",
      "version_source": "windows/runtime/source/Sokna.Runtime.Service.csproj#Version"
    },
    "print-agent": {
      "version": "6.2.6",
      "print_server_protocol": 4,
      "loopback_protocol": 1,
      "service_name": "SoknaPrintWorker",
      "version_source": "windows/print-agent/source/Directory.Build.props#SoknaAgentVersion"
    }
  },
  "external_infrastructure": {
    "owner": "external",
    "installer_ownership": false,
    "compatibility_source": "platform/windows/prerequisites.json",
    "release_lock_source": "platform/windows/release-lock.json"
  },
  "forbidden_payload_ownership": [
    "local-web",
    "public-edge",
    "php",
    "apache",
    "mariadb",
    "business-data"
  ],
  "package_version": "1.0.4",
  "activation_rule": "verify-shell-hashes-and-component-versions-before-service-mutation",
  "lifecycle_ownership": {
    "windows_services": [
      "SoknaRuntime",
      "SoknaPrintWorker"
    ],
    "business_data": false,
    "external_infrastructure": false,
    "local_web": false,
    "public_edge": false
  }
}
