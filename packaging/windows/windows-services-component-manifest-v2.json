{
  "format": "sokna-windows-component-manifest-v2",
  "schema_version": 2,
  "package_component": "windows-services-packaging",
  "package_version": "1.1.9",
  "planner_contract": "1.0",
  "components": [
    {
      "component_id": "runtime",
      "display_name_fa": "Runtime",
      "kind": "service",
      "primary": true,
      "required": true,
      "version": "1.0.5",
      "service_name": "SoknaRuntime",
      "payload_primary": "_payload/runtime/SoknaRuntimeService.exe",
      "installed_primary": "Runtime/SoknaRuntimeService.exe",
      "restart_scope": "service",
      "transaction_group": "runtime",
      "health_policy": "running_when_paired_or_manual_when_unpaired",
      "dependencies": []
    },
    {
      "component_id": "print-agent",
      "display_name_fa": "Print Agent",
      "kind": "service",
      "primary": true,
      "required": true,
      "version": "6.2.9",
      "service_name": "SoknaPrintWorker",
      "payload_primary": "_payload/print-worker/Service/Sokna.PrintAgent.Service.exe",
      "installed_primary": "PrintAgent/Service/Sokna.PrintAgent.Service.exe",
      "restart_scope": "service",
      "transaction_group": "print-agent",
      "health_policy": "running",
      "dependencies": []
    },
    {
      "component_id": "maintenance",
      "display_name_fa": "Maintenance",
      "kind": "service",
      "primary": true,
      "required": true,
      "version": "0.3.6",
      "service_name": "SoknaMaintenanceSupervisor",
      "payload_primary": "_payload/maintenance/app/SoknaMaintenanceSupervisor.exe",
      "installed_primary": "Maintenance/App/SoknaMaintenanceSupervisor.exe",
      "restart_scope": "component_group",
      "transaction_group": "maintenance",
      "health_policy": "running",
      "dependencies": [
        {
          "component_id": "maintenance-update-engine",
          "version": "0.3.6"
        },
        {
          "component_id": "maintenance-recovery-console",
          "version": "0.1.1"
        }
      ]
    },
    {
      "component_id": "maintenance-update-engine",
      "display_name_fa": "Update Engine",
      "kind": "engine",
      "primary": false,
      "required": true,
      "parent_component": "maintenance",
      "version": "0.3.6",
      "payload_primary": "_payload/maintenance/app/SoknaMaintenanceUpdateEngine.exe",
      "installed_primary": "Maintenance/App/SoknaMaintenanceUpdateEngine.exe",
      "restart_scope": "process",
      "transaction_group": "maintenance",
      "health_policy": "on_demand",
      "dependencies": []
    },
    {
      "component_id": "maintenance-recovery-console",
      "display_name_fa": "Recovery Console",
      "kind": "console",
      "primary": false,
      "required": true,
      "parent_component": "maintenance",
      "version": "0.1.1",
      "payload_primary": "_payload/maintenance/recovery/SoknaMaintenanceRecoveryConsole.exe",
      "installed_primary": "Maintenance/Recovery/SoknaMaintenanceRecoveryConsole.exe",
      "restart_scope": "process",
      "transaction_group": "maintenance",
      "health_policy": "on_demand_independent_from_local_web",
      "dependencies": []
    }
  ],
  "rules": {
    "version_only_is_sufficient": false,
    "same_version_hash_drift": "REPAIR",
    "service_registration_drift": "REPAIR",
    "unsafe_service_image_outside_owned_root": "BLOCKED",
    "unsupported_newer_component": "BLOCKED",
    "required_missing_component": "INSTALL",
    "keep_mutation_allowed": false,
    "keep_restart_allowed": false,
    "required_component_deselection_allowed": false
  }
}
