+(()=>{'use strict';
+const card=document.querySelector('[data-open-accounts-kpi][data-url]');if(!card)return;
+const amount=card.querySelector('strong'),hint=card.querySelector('div>span:not(.sc-dashboard-kpi__delta)');if(!amount)return;
