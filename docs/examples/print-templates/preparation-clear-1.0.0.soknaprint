    "margin": 8,
    "show_time": true,
    "show_order_number": true,
    "show_section_titles": true,
    "design": {
      "density": "compact",
      "header_alignment": "center",
      "separator_style": "dashed",
      "item_layout": "two-line",
      "section_order": ["status", "meta", "items", "notes", "footer"]
    }
  }
}
