{
  "format": "sokna-print-template-package-v1",
  "template_key": "preparation-clear",
  "name": "آماده‌سازی · خوانا",
  "version": "1.0.0",
  "document_kind": "preparation",
  "description": "قالب نمونه فیش آماده‌سازی روی renderer رسمی سکنا.",
  "template": {
    "base_font_size": 25,
    "title_font_size": 30,
    "table_font_size": 32,
