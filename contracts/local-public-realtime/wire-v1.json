  "status": "extracted_legacy_wire_contract_for_v3_review",
  "authentication": {
    "algorithm": "HMAC-SHA256",
    "headers": {
      "timestamp": "X-SOKNA-TIMESTAMP",
      "nonce": "X-SOKNA-NONCE",
      "signature": "X-SOKNA-SIGNATURE"
