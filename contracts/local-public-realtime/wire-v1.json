      "max_length": 96,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "payload_type": "object",
    "expected_version_types": ["integer", "string"],
    "expected_state_type": "string",
    "time_rule": "expires_at must parse and be strictly after created_at"
  },
  "states": {
    "workflow": ["queued", "claimed", "committed", "rejected", "expired", "cancelled", "unknown_review"],
    "terminal": ["committed", "rejected", "expired", "cancelled", "unknown_review"]
