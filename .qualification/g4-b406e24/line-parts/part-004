 function renderReceipts(){const b=$('[data-receipt-list]');b.replaceChildren();snap.supply.recent_receipts.forEach(r=>{const tr=document.createElement('tr');cell(tr,'زمان',r.received_at);cell(tr,'کالا',r.item_name);cell(tr,'مقدار',`${major(r.received_quantity_base,r.base_unit)} ${unitLabel(r.base_unit)}`);cell(tr,'هزینه',r.total_cost===null?'—':money(r.total_cost));cell(tr,'تأمین‌کننده',r.supplier||'—');b.append(tr)})}
+function renderDeferredReviews(){const b=$('[data-deferred-reviews]');if(!b)return;b.replaceChildren();const rows=snap.deferred_reviews||[];if(!rows.length){const tr=document.createElement('tr'),td=document.createElement('td');td.colSpan=6;td.textContent='موردی برای بررسی وجود ندارد.';tr.append(td);b.append(tr);return}rows.forEach(r=>{const tr=document.createElement('tr');cell(tr,'زمان',r.created_at);cell(tr,'نوع',r.kind);cell(tr,'کاربر',r.actor_name||'—');cell(tr,'علت',r.reason_code);cell(tr,'پیام',r.message||'—');const td=document.createElement('td');td.dataset.label='عملیات';const act=el('div','sc-actions');act.append(button('تأیید',()=>resolveDeferred(r,'approve'),'primary'),button('رد',()=>resolveDeferred(r,'reject'),'danger'));td.append(act);tr.append(td);b.append(tr)})}
+async function resolveDeferred(r,decision){const reason=prompt(decision==='approve'?'دلیل تأیید را ثبت کن:':'دلیل رد را ثبت کن:','بررسی مدیر');if(!reason)return;try{await post({action:'deferred_resolve',review_id:Number(r.review_id),kind:r.kind,decision,reason});await refresh('مورد Deferred تعیین تکلیف شد و برای reconcile آماده است.')}catch(e){status(e.message,true)}}
 function renderExpenses(){const b=$('[data-expense-list]');b.replaceChildren();(snap.expenses?.recent||[]).forEach(r=>{const tr=document.createElement('tr');cell(tr,'زمان',r.occurred_at);cell(tr,'دسته',r.category_name);cell(tr,'شرح',r.description||'—');cell(tr,'مبلغ',money(r.amount));cell(tr,'دوره',r.period_title);cell(tr,'وضعیت',r.status);const td=document.createElement('td');td.dataset.label='عملیات';if(r.status==='committed')td.append(button('برگشت',()=>{const f=$('[data-form="expense-reverse"]');f.elements.expense_id.value=String(r.id);$('[data-reverse-expense]').textContent=`${r.category_name} · ${money(r.amount)} · ${r.description||''}`;openDialog('expense-reverse')},'danger'));tr.append(td);b.append(tr)})}
 async function refresh(done=''){try{status('در حال دریافت وضعیت عملیات…');const j=await request(`${api}?action=snapshot`);snap=j.snapshot;render();status(done||'وضعیت عملیات به‌روز شد.')}catch(e){status(e.message,true)}}
