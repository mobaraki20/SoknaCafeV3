+.sc-preparation-tab b{font-size:.73rem;border-radius:10px;background:var(--sc-surface-subtle);padding:2px 8px}
+.sc-preparation-tab.is-current{border-color:var(--sc-accent);background:var(--sc-accent-soft);color:var(--sc-accent)}
+.sc-preparation-tab-panel{min-inline-size:0}
+
+
+/* R203: retain every historical record, hide old versions from daily lists. */
+.sc-history-archive{border:1px solid var(--sc-border,#d8e0dc);border-radius:12px;margin-block:12px;overflow:hidden}
+.sc-history-archive>summary{padding:12px 16px;cursor:pointer;font-weight:750;font-size:.84rem;list-style-position:inside;background:var(--sc-surface-subtle,#f4f6f5)}
+.sc-history-archive__body{padding:10px;display:grid;gap:10px}
+.sc-template-live-block{margin:0 16px 14px;border:1px solid var(--sc-border,#d8e0dc);border-radius:12px;background:var(--sc-surface-subtle,#f4f6f5);padding:12px}
+.sc-template-live-stage{display:flex;justify-content:center;padding:8px;max-height:320px;overflow-y:auto}
+.sc-template-live-paper{width:min(100%,300px);background:white;color:#202c29;padding:18px 13px;box-shadow:0 2px 14px #0001;font-size:12px;font-family:inherit;min-height:190px}
+.sc-template-live-paper h4{text-align:center;border-bottom:1px solid #777;margin:0 0 8px;padding-bottom:9px;font-size:15px}
+.sc-template-live-paper h5{font-size:12px;margin:12px 0 5px}
+.sc-template-live-paper .sc-template-live-row{display:flex;justify-content:space-between;gap:15px;padding:4px 0}
+.sc-template-live-paper.is-compact .sc-template-live-row{padding:1px 0}
+.sc-template-live-paper.is-dashed h4{border-bottom-style:dashed}
+.sc-template-live-paper.is-minimal h4{border-bottom:0}
+.sc-template-live-footer{text-align:center;margin:14px 0 0;padding-top:7px;border-top:1px solid #ddd;white-space:pre-wrap}
