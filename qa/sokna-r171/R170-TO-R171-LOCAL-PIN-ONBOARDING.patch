+-- R171 cafe-only named employee onboarding. Local operator; Public remote access disabled.
+-- One-time, all-DML atomic migration; no existing password is reset or overwritten.
+-- Four-digit credential stored only as a salted bcrypt hash, never plaintext.
+-- This customer-specific migration must not be transplanted to a generic product release.
+SELECT (SELECT x FROM (SELECT 1 x UNION ALL SELECT 2 x) fail WHERE EXISTS (
+ SELECT 1 FROM users WHERE username='mohammad.mobaraki'
+ AND (display_name<>'محمد مبارکی' OR role<>'operator')
+));
+SELECT (SELECT x FROM (SELECT 1 x UNION ALL SELECT 2 x) fail WHERE EXISTS (
+ SELECT 1 FROM users WHERE display_name='محمد مبارکی' AND username<>'mohammad.mobaraki'
+));
+SELECT (SELECT x FROM (SELECT 1 x UNION ALL SELECT 2 x) fail WHERE EXISTS (
+ SELECT 1 FROM personnel WHERE display_name='محمد مبارکی' AND linked_user_id IS NOT NULL
+ AND linked_user_id<>COALESCE((SELECT id FROM users WHERE username='mohammad.mobaraki' LIMIT 1),0)
+));
+SELECT (SELECT x FROM (SELECT 1 x UNION ALL SELECT 2 x) fail WHERE EXISTS (
+ SELECT 1 FROM personnel WHERE display_name='محمد مبارکی' AND (SELECT COUNT(*) FROM personnel p2 WHERE p2.display_name='محمد مبارکی')>1
+));
+INSERT INTO users(username,password_hash,display_name,role,active)
+SELECT 'mohammad.mobaraki','$2y$12$VGe75b/2Ddyuc3NcXoUrmOc14BujCGaRI.iGJPg9BYKKqF.vhGtG.','محمد مبارکی','operator',1
+WHERE NOT EXISTS(SELECT 1 FROM users WHERE username='mohammad.mobaraki');
+INSERT INTO user_capabilities(user_id,capability,enabled)
+SELECT u.id,v.capability,v.enabled FROM users u JOIN (
+SELECT 'orders_floor' capability,0 enabled
+UNION ALL
+SELECT 'cashier_accounts' capability,0 enabled
+UNION ALL
+SELECT 'preparation' capability,0 enabled
+UNION ALL
+SELECT 'shift_supervision' capability,0 enabled
+UNION ALL
+SELECT 'inventory_view' capability,1 enabled
+UNION ALL
+SELECT 'inventory_cost_view' capability,1 enabled
+UNION ALL
+SELECT 'inventory_operations' capability,1 enabled
+UNION ALL
+SELECT 'inventory_finalize' capability,1 enabled
+UNION ALL
+SELECT 'inventory_manage' capability,1 enabled
+UNION ALL
+SELECT 'expenses_record' capability,1 enabled
+UNION ALL
+SELECT 'staff_consumption_self' capability,0 enabled
+UNION ALL
+SELECT 'staff_consumption_proxy' capability,0 enabled
+UNION ALL
+SELECT 'staff_benefit_manage' capability,0 enabled
+UNION ALL
+SELECT 'staff_account_manage' capability,0 enabled
+UNION ALL
+SELECT 'staff_consumption_reports' capability,0 enabled
+UNION ALL
+SELECT 'remote_access' capability,0 enabled
+) v WHERE u.username='mohammad.mobaraki' AND u.display_name='محمد مبارکی' AND u.role='operator'
+ON DUPLICATE KEY UPDATE enabled=VALUES(enabled);
+UPDATE personnel p JOIN users u ON u.username='mohammad.mobaraki' AND u.display_name='محمد مبارکی'
+SET p.linked_user_id=u.id,p.active=1,p.job_title='مسئول خرید، انبار و هزینه‌ها'
+WHERE p.display_name='محمد مبارکی' AND p.linked_user_id IS NULL;
+INSERT INTO personnel(display_name,job_title,linked_user_id,active)
+SELECT 'محمد مبارکی','مسئول خرید، انبار و هزینه‌ها',u.id,1
+FROM users u WHERE u.username='mohammad.mobaraki' AND u.display_name='محمد مبارکی'
+AND NOT EXISTS(SELECT 1 FROM personnel p WHERE p.linked_user_id=u.id OR p.display_name='محمد مبارکی');
+-- Ensure identity is singular, linked, active and Local-only. Never delete existing users.
+SELECT (SELECT x FROM (SELECT 1 x UNION ALL SELECT 2 x) fail WHERE
+ (SELECT COUNT(*) FROM users WHERE username='mohammad.mobaraki' AND display_name='محمد مبارکی' AND role='operator' AND active=1)<>1
+ OR (SELECT COUNT(*) FROM personnel p JOIN users u ON u.id=p.linked_user_id WHERE u.username='mohammad.mobaraki' AND p.display_name='محمد مبارکی' AND p.active=1)<>1
+ OR EXISTS(SELECT 1 FROM user_capabilities c JOIN users u ON u.id=c.user_id WHERE u.username='mohammad.mobaraki' AND c.capability='remote_access' AND c.enabled=1)
+);
