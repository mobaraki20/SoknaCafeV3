+        $fingerprint=hash('sha256',json_encode($canonical,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR));
+        $q=$pdo->prepare("SELECT details_json FROM audit_log WHERE entity_type='manual_mutation_receipt' AND entity_id=? AND action=? AND actor_user_id=? ORDER BY id DESC LIMIT 1 FOR UPDATE");$q->execute([$key,$action.'.receipt',$uid]);$raw=$q->fetchColumn();
+        $result=null;
