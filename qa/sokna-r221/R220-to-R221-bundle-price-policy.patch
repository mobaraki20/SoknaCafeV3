+++ b/src/Domain/Sellables/BundlePricePolicy.php
@@ -0,0 +1,43 @@
+<?php
+declare(strict_types=1);
+
+namespace Sokna\Local\Domain\Sellables;
+
+/**
+ * Financially safe, exact-integer bundle pricing.
+ * Maximum order quantity is 100; the bound keeps the resulting order total
+ * within JavaScript's safe integer range, including after multiplication.
+ */
+final class BundlePricePolicy
+{
+    public const MAX_SAFE_ORDER_TOTAL = 9_007_199_254_740_991;
+    public const MAX_UNIT_PRICE = 90_071_992_547_409; // intdiv(MAX_SAFE_ORDER_TOTAL, 100)
+
+    /** @param list<int> $deltas */
+    public static function deltaSum(array $deltas): ?int
+    {
+        $plus = 0;
+        $minus = 0;
+        foreach ($deltas as $delta) {
+            if (!is_int($delta)) return null;
+            if ($delta >= 0) {
+                if ($delta > self::MAX_SAFE_ORDER_TOTAL - $plus) return null;
+                $plus += $delta;
+            } else {
+                if ($delta < -self::MAX_SAFE_ORDER_TOTAL - $minus) return null;
+                $minus += $delta;
+            }
+        }
+        return $plus + $minus;
+    }
+
+    /** @param list<int> $deltas */
+    public static function unitPrice(int $parentPrice, array $deltas): ?int
+    {
+        if ($parentPrice < 0 || $parentPrice > self::MAX_UNIT_PRICE) return null;
+        $delta = self::deltaSum($deltas);
+        if ($delta === null) return null;
+        $price = $parentPrice + $delta;
+        return $price >= 0 && $price <= self::MAX_UNIT_PRICE ? $price : null;
+    }
+}
