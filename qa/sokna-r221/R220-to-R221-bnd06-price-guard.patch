+    /** Validate fixed additions and EACH alternative choice separately. */
+    private static function validateBundleOptions(int $basePrice,array $components): void
+    {
+        $fixedDelta=0;$choices=[];
+        foreach($components as $part){
+            if((string)$part['mode']==='fixed')$fixedDelta=self::safeBundleDeltaSum($fixedDelta,(int)$part['price_delta']);
