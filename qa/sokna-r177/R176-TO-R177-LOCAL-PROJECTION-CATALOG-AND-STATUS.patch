+    /**
+     * Repair ONLY static transport metadata after the one-time go-live purge.
+     * No business rows, authority epochs, Public settings, or migration ledger
+     * are modified. This is idempotent across interrupted resync attempts.
+     * The catalog remains necessary for the normal AFTER INSERT trigger.
+     */
+    private function restoreProjectionCatalogAfterGoLive(): void
+    {
+        if ($this->authorityState === null || !$this->authorityState->resyncRequired()) return;
+        $keys = $this->builder->remoteModelKeys();
+        if (count($keys) !== 11 || count(array_unique($keys)) !== 11) {
+            throw new \RuntimeException('GOLIVE_PROJECTION_MODEL_CATALOG_INVALID');
+        }
+        foreach ($keys as $key) {
+            if (preg_match('/^[a-z][a-z0-9_]{0,63}$/D', $key) !== 1)
+                throw new \RuntimeException('GOLIVE_PROJECTION_MODEL_CATALOG_INVALID');
+        }
+        $this->pdo->beginTransaction();
+        try {
+            $actual = $this->pdo->query('SELECT model_key FROM public_projection_model_catalog ORDER BY model_key')->fetchAll(PDO::FETCH_COLUMN) ?: [];
+            if (array_diff($actual, $keys))
+                throw new \RuntimeException('GOLIVE_PROJECTION_MODEL_CATALOG_UNEXPECTED');
+            $insert = $this->pdo->prepare('INSERT IGNORE INTO public_projection_model_catalog(model_key) VALUES(?)');
+            foreach ($keys as $key) $insert->execute([$key]);
+            $after = $this->pdo->query('SELECT model_key FROM public_projection_model_catalog ORDER BY model_key')->fetchAll(PDO::FETCH_COLUMN) ?: [];
+            $expected = $keys; sort($expected, SORT_STRING);
+            if ($after !== $expected)
+                throw new \RuntimeException('GOLIVE_PROJECTION_MODEL_CATALOG_RESTORE_FAILED');
+            $this->pdo->commit();
+        } catch (Throwable $e) {
+            if ($this->pdo->inTransaction()) $this->pdo->rollBack();
+            throw $e;
+        }
     }
 
