+<?php
+declare(strict_types=1);
+
+namespace Sokna\Local\Core;
+
+use RuntimeException;
+
+/**
+ * Opt-in 14-day browser sign-in for Local. No raw password or bearer token is
+ * persisted on disk: only SHA-256(token), user id and password-hash fingerprint.
+ * Storage is under the persistent DATA root (outside the managed Web tree).
+ */
+final class RememberDeviceStore
+{
+    public const COOKIE = 'SOKNA_LOCAL_REMEMBER';
+    public const TTL_SECONDS = 14 * 86400;
+
+    public function __construct(private readonly string $dataRoot) {}
+
+    /** Refuse a durable bearer cookie over clear-text LAN HTTP. */
+    public static function allowedOnRequest(array $server): bool
+    {
+        $https = strtolower(trim((string)($server['HTTPS'] ?? '')));
+        if ($https === 'on' || $https === '1') return true;
+        // A Host header is caller-controlled; it MUST NOT be trusted as proof of
+        // loopback. Require the actual peer IP to be loopback as well.
+        $host = (string)($server['HTTP_HOST'] ?? '');
+        $hostname = parse_url('http://' . $host, PHP_URL_HOST);
+        $peer = (string)($server['REMOTE_ADDR'] ?? '');
+        return in_array(strtolower((string)$hostname), ['localhost', '127.0.0.1', '::1'], true)
+            && in_array($peer, ['127.0.0.1', '::1'], true);
+    }
+
+    public function issue(int $userId, string $passwordHash, array $server, ?int $now = null): string
+    {
+        if ($userId < 1 || $passwordHash === '' || !self::allowedOnRequest($server)) {
+            throw new RuntimeException('Secure device-remembering not available for this connection.');
+        }
+        $now ??= time();
+        $dir = $this->directory();
+        if (!is_dir($dir) && !@mkdir($dir, 0700, true) && !is_dir($dir)) throw new RuntimeException('Remember-device storage not available.');
+        @chmod($dir, 0700);
+        for ($tries = 0; $tries < 3; $tries++) {
+            $token = bin2hex(random_bytes(32));
+            $digest = hash('sha256', $token);
+            $path = $dir . DIRECTORY_SEPARATOR . $digest . '.json';
+            $handle = @fopen($path, 'x');
+            if ($handle === false) continue;
+            @chmod($path, 0600);
+            try {
+                $record = [
+                    'format' => 'sokna-local-remember-v1',
+                    'token_hash' => $digest,
+                    'user_id' => $userId,
+                    'password_fingerprint' => hash('sha256', $passwordHash),
+                    'created_at' => $now,
+                    'expires_at' => $now + self::TTL_SECONDS,
+                ];
+                $raw = json_encode($record, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
+                if (fwrite($handle, $raw) !== strlen($raw)) throw new RuntimeException('Incomplete remember-device write.');
+                fflush($handle);
+            } catch (\Throwable $error) {
+                @unlink($path);
+                throw $error;
+            } finally {
+                fclose($handle);
+            }
+            return $token;
+        }
+        throw new RuntimeException('Cannot create a remembered device token.');
+    }
+
+    /** @return array{user_id:int,password_fingerprint:string}|null */
+    public function resolve(string $token, ?int $now = null): ?array
+    {
+        $path = $this->fileForToken($token);
+        if ($path === null || !is_file($path)) return null;
+        $raw = @file_get_contents($path);
+        $record = is_string($raw) ? json_decode($raw, true) : null;
+        if (!is_array($record) || ($record['format'] ?? '') !== 'sokna-local-remember-v1'
+            || !hash_equals((string)($record['token_hash'] ?? ''), hash('sha256', $token))
+            || (int)($record['expires_at'] ?? 0) <= ($now ?? time())
+            || (int)($record['user_id'] ?? 0) < 1
+            || !preg_match('/^[a-f0-9]{64}$/D', (string)($record['password_fingerprint'] ?? ''))) {
+            @unlink($path);
+            return null;
+        }
+        return ['user_id' => (int)$record['user_id'], 'password_fingerprint' => (string)$record['password_fingerprint']];
+    }
+
+    public function revoke(string $token): void
+    {
+        $path = $this->fileForToken($token);
+        if ($path !== null && is_file($path)) @unlink($path);
+    }
+
+    public function setCookie(string $token, array $server): void
+    {
+        if (PHP_SAPI === 'cli') return;
+        $secure = in_array(strtolower((string)($server['HTTPS'] ?? '')), ['on', '1'], true);
+        setcookie(self::COOKIE, $token, [
+            'expires' => time() + self::TTL_SECONDS,
+            'path' => Session::cookiePathForRequest(),
+            'secure' => $secure,
+            'httponly' => true,
+            'samesite' => 'Strict',
+        ]);
+    }
+
+    public function revokeCurrentAndClear(array $server): void
+    {
+        $this->revoke((string)($_COOKIE[self::COOKIE] ?? ''));
+        if (PHP_SAPI === 'cli') return;
+        $secure = in_array(strtolower((string)($server['HTTPS'] ?? '')), ['on', '1'], true);
+        setcookie(self::COOKIE, '', [
+            'expires' => time() - 3600,
+            'path' => Session::cookiePathForRequest(),
+            'secure' => $secure,
+            'httponly' => true,
+            'samesite' => 'Strict',
+        ]);
+    }
+
+    private function directory(): string
+    {
+        return rtrim($this->dataRoot, '\\/') . DIRECTORY_SEPARATOR . 'auth' . DIRECTORY_SEPARATOR . 'remembered-devices';
+    }
+
+    private function fileForToken(string $token): ?string
+    {
+        if (!preg_match('/^[a-f0-9]{64}$/D', $token)) return null;
+        return $this->directory() . DIRECTORY_SEPARATOR . hash('sha256', $token) . '.json';
+    }
+}
