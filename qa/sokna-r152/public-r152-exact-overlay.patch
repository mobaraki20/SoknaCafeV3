+/* R152 guest UX: compact optional global fulfillment and responsive content */
+.sg-body details.sg-fulfillment-review--compact{display:block;padding:9px 12px;min-inline-size:0}
+.sg-body details.sg-fulfillment-review--compact>summary{list-style:none;cursor:pointer;min-block-size:42px;display:flex;align-items:center;gap:8px;min-inline-size:0}
+.sg-body details.sg-fulfillment-review--compact>summary::-webkit-details-marker{display:none}
+.sg-body details.sg-fulfillment-review--compact>summary::after{content:'⌄';color:var(--sg-primary);font-size:1rem;font-weight:900;margin-inline-start:auto;flex:0 0 auto}
+.sg-body details.sg-fulfillment-review--compact[open]>summary::after{transform:rotate(180deg)}
+.sg-body details.sg-fulfillment-review--compact>summary>div{min-inline-size:0;flex:1 1 auto}
+.sg-body details.sg-fulfillment-review--compact>summary>span{flex:0 1 auto;max-inline-size:44%;text-align:end}
+.sg-body .sg-fulfillment-review__body{display:grid;gap:9px;padding-block-start:10px}
+.sg-body .sg-fulfillment-review__body>p{margin:0;color:var(--sg-muted);font-size:.72rem;line-height:1.7}
+.sg-body .sg-cart-lines,.sg-body .sg-cart-line{min-inline-size:0}
+@media(max-width:560px){.sg-body .sg-drawer-body{padding:10px 12px 16px;gap:10px}.sg-body .sg-fulfillment-review__body>p{font-size:.68rem}}
+/* R152: an attached dock must not leave a full-width blank strip when the cart is empty. */
+.sg-theme-v2.sg-v-action-dock-attached .sg-action-dock:not(:has(.sg-basket:not([hidden]))){inline-size:max-content;max-inline-size:calc(100% - 24px);padding:0;background:transparent;border:0;box-shadow:none}
