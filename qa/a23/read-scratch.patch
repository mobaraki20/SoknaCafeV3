+    /** Dedicated, versioned scratch namespace for pre-mutation operations only.
+     * Never sweep recovery-tmp, restore journals, or user backup destinations.
+     * After a killed process, the next holder of the stable lock removes only
+     * abandoned scratch files in this namespace. This is not secure erase.
+     */
+    private function acquireReadScratch(string $externalPath): array
+    {
+        $root=realpath($this->observability->dataRoot());
+        if($root===false||!is_dir($root))throw new RecoveryException('temp_unavailable','فضای موقت پشتیبان آماده نیست.',500);
+        $dir=$root.DIRECTORY_SEPARATOR.'recovery-read-scratch-v1';
+        if(is_link($dir)||(!is_dir($dir)&&!@mkdir($dir,0700)&&!is_dir($dir)))throw new RecoveryException('temp_unavailable','فضای موقت پشتیبان آماده نیست.',500);
+        $canonical=static function(string $p):string{$p=rtrim(str_replace('\\','/',$p),'/');return PHP_OS_FAMILY==='Windows'?strtolower($p):$p;};
+        $actual=realpath($dir);
+        if($actual===false||$canonical($actual)!==$canonical($dir)||is_link($dir))throw new RecoveryException('temp_unavailable','مسیر موقت پشتیبان معتبر نیست.',500);
+        if(PHP_OS_FAMILY!=='Windows'&&((fileperms($dir)&0077)!==0))throw new RecoveryException('temp_unavailable','مجوز فضای موقت پشتیبان معتبر نیست.',500);
+        $external=realpath($externalPath);
+        if($external===false){$parent=realpath(dirname($externalPath));if($parent!==false)$external=$parent.DIRECTORY_SEPARATOR.basename($externalPath);}
+        if($external!==false&&($canonical($external)===$canonical($dir)||str_starts_with($canonical($external),$canonical($dir).'/')))throw new RecoveryException('invalid_path','مسیر موقت داخلی برای فایل پشتیبان مجاز نیست.',422);
+        $lockPath=$dir.DIRECTORY_SEPARATOR.'.scratch.lock';
+        if(is_link($lockPath)||(file_exists($lockPath)&&!is_file($lockPath)))throw new RecoveryException('temp_unavailable','قفل فضای موقت معتبر نیست.',500);
+        $lock=@fopen($lockPath,'c+b');
+        if(!$lock)throw new RecoveryException('temp_unavailable','قفل فضای موقت در دسترس نیست.',500);
+        try{
+            if(!flock($lock,LOCK_EX|LOCK_NB))throw new RecoveryException('backup_scratch_busy','عملیات دیگری روی پشتیبان در جریان است.',409);
+            clearstatcache(true,$lockPath);
+            $ls=@lstat($lockPath);$fs=fstat($lock);
+            if(is_link($lockPath)||!is_array($ls)||!is_array($fs)||$ls['ino']!==$fs['ino']||$ls['dev']!==$fs['dev']||$ls['nlink']!==1)throw new RecoveryException('temp_unavailable','قفل فضای موقت معتبر نیست.',500);
+            @chmod($lockPath,0600);
+            $entries=@scandir($dir);
+            if($entries===false)throw new RecoveryException('temp_unavailable','فضای موقت قابل بررسی نیست.',500);
+            // Validate every candidate before removing anything. Never follow links.
+            $orphans=[];
+            foreach($entries as $entry){
+                if(!preg_match('/^business-(?:backup|inspect)-[a-f0-9]{32}\.ndjson\.gz$/D',$entry))continue;
+                $file=$dir.DIRECTORY_SEPARATOR.$entry;$st=@lstat($file);
+                if(!is_array($st)||is_link($file)||!is_file($file)||$st['nlink']!==1||$canonical((string)realpath($file))!==$canonical($file))throw new RecoveryException('backup_scratch_cleanup_pending','فایل موقت نامعتبر است؛ نیازمند بررسی.',409);
+                $orphans[]=$file;
+            }
+            foreach($orphans as $file)if(!@unlink($file))throw new RecoveryException('backup_scratch_cleanup_pending','پاک‌سازی فایل موقت کامل نشد.',500);
+            return ['dir'=>$dir,'lock'=>$lock];
+        }catch(Throwable $e){fclose($lock);throw $e;}
+    }
