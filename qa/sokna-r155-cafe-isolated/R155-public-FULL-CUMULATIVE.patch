+/* ORD-001 2026-11-11 — mobile ORDER tab only. The catalogue/menu tab
+   and both desktop layouts remain untouched. Ensure all three actions remain
+   visible, with submit on the right, save next, and full total on the left. */
+@media(max-width:700px){
+ .sc-order-workspace-v107 .sc-order-mobile-dock{
+  direction:rtl!important;
+  display:grid!important;
+  grid-template-columns:minmax(91px,1.05fr) minmax(79px,.9fr) minmax(89px,1.07fr)!important;
+  gap:5px!important;align-items:center;
+ }
+ .sc-order-workspace-v107 .sc-order-mobile-dock>[data-order-finalize],
+ .sc-order-workspace-v107 .sc-order-mobile-dock>[data-order-save]{
+  inline-size:100%!important;min-inline-size:0!important;min-block-size:48px;
+  padding:7px 4px!important;font-size:clamp(11px,3vw,13px)!important;
+  line-height:1.3;text-align:center;white-space:normal!important;
+ }
+ .sc-order-workspace-v107 .sc-order-mobile-summary{
+  min-inline-size:0!important;inline-size:100%;overflow:visible!important;
+  display:flex!important;flex-direction:column;justify-content:center;
+  align-items:flex-start;text-align:right!important;direction:rtl;
+  padding:2px 3px!important;
+ }
+ .sc-order-workspace-v107 .sc-order-mobile-amount{
+  display:flex;flex-direction:column;align-items:flex-start;gap:1px;
+  inline-size:100%;line-height:1.35;white-space:normal!important;
+ }
+ .sc-order-workspace-v107 .sc-order-mobile-amount-number{
+  display:block;font-size:clamp(12px,3.3vw,15px);font-weight:850;
+  white-space:nowrap;max-inline-size:100%;overflow:visible;
+  font-variant-numeric:tabular-nums;
+ }
+ .sc-order-workspace-v107 .sc-order-mobile-amount-unit{
+  display:block;font-size:10px;font-weight:650;color:var(--sc-muted);
+ }
+}
