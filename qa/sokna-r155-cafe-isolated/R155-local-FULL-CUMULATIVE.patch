+    /** Resolve the invoice number first; numeric legacy links may use the row ID. */
+    public function invoiceIdForReference(string $reference): int
+    {
+        $reference=self::invoiceDigits(trim($reference));
+        if($reference===''||strlen($reference)>160)throw new SettlementException('invalid_invoice','شماره فاکتور معتبر نیست.',422);
+        $query=$this->pdo->prepare('SELECT id FROM settlement_records WHERE invoice_number=? LIMIT 1');
+        $query->execute([$reference]);$id=$query->fetchColumn();
+        if($id===false&&preg_match('/^[1-9][0-9]{0,14}$/D',$reference)){
+            $query=$this->pdo->prepare('SELECT id FROM settlement_records WHERE id=? LIMIT 1');
+            $query->execute([(int)$reference]);$id=$query->fetchColumn();
+        }
+        if($id===false)throw new SettlementException('invoice_not_found','فاکتور موردنظر پیدا نشد.',404);
+        return (int)$id;
+    }
+
+    private static function invoiceDigits(string $value): string
+    {
+        return strtr($value,['۰'=>'0','۱'=>'1','۲'=>'2','۳'=>'3','۴'=>'4','۵'=>'5','۶'=>'6','۷'=>'7','۸'=>'8','۹'=>'9',
+            '٠'=>'0','١'=>'1','٢'=>'2','٣'=>'3','٤'=>'4','٥'=>'5','٦'=>'6','٧'=>'7','٨'=>'8','٩'=>'9']);
     }
 
