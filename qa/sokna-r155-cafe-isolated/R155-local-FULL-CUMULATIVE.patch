+                throw new SettlementException('invalid_invoice_date','تاریخ فیلتر معتبر نیست.',422);
+        }
+        if($from!==''&&$to!==''&&$from>$to)throw new SettlementException('invalid_invoice_date_range','تاریخ شروع نباید بعد از پایان باشد.',422);
+        $page=max(1,min(100000,(int)($filters['page']??1)));
